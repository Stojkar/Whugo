<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="600.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cz.stojkar.whugo.controllers.HospodaController">
   <children>
      <!-- Pozadí lokace -->
      <ImageView fitHeight="600.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@images/hospoda.png" />
         </image>
      </ImageView>

      <!-- Aktivní oblast pro zadní místnost (tmavší část) -->
      <Rectangle fx:id="zadniMistnost" layoutX="280.0" layoutY="160.0" width="380.0" height="230.0"
                 fill="transparent" pickOnBounds="true"
                 onMouseClicked="#onZadniMistnostClicked"
                 onMouseEntered="#onMouseEntered"
                 onMouseExited="#onMouseExited" />

      <!-- Hrdina -->
      <ImageView fx:id="heroSprite" fitHeight="250.0" fitWidth="150.0" layoutX="500.0" layoutY="350.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/hrdina_stoji.png" />
         </image>
      </ImageView>

      <!-- Navigační šipka -->
      <ImageView fx:id="arrowDown" fitHeight="80.0" fitWidth="80.0" layoutX="600.0" layoutY="500.0" onMouseClicked="#goToUlice1" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/sipka_dolu.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
